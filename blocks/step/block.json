{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "uat-checklist/step",
	"version": "0.1.0",
	"title": "Checklist step",
	"category": "widgets",
	"icon": "yes",
	"description": "One test step and its expected result. Testers mark it Pass or Fail and can add a comment.",
	"textdomain": "uat-checklist",
	"parent": ["uat-checklist/section"],
	"usesContext": ["postId"],
	"attributes": {
		"stepId": { "type": "string", "default": "" },
		"step": { "type": "string", "default": "" },
		"expected": { "type": "string", "default": "" },
		"instructions": { "type": "array", "default": [] },
		"expectedItems": { "type": "array", "default": [] },
		"imageUrl": { "type": "string", "default": "" },
		"imageAlt": { "type": "string", "default": "" },
		"required": { "type": "boolean", "default": true }
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
