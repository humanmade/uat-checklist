#!/usr/bin/env bash
#
# Translation toolchain for the plugin's own strings.
#
# Usage:
#   bin/i18n                 # regenerate the POT, merge it into every catalog, then compile them
#   bin/i18n pot             # regenerate the POT only
#   bin/i18n locale <xx>     # create a locale's PO, or merge new strings into it
#   bin/i18n compile [<xx>]  # compile PO -> MO + l10n.php + JSON, one locale or all; needs `npm run build`
#   bin/i18n check           # fail when the POT no longer matches the code or a PO does not parse
#
# Runs on the host: WP-CLI's i18n commands parse files and need neither WordPress nor a database. `check` also
# needs msgfmt from gettext.

set -euo pipefail

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

readonly DOMAIN='uat-checklist'
readonly PACKAGE_NAME='UAT Checklist'
readonly LANG_DIR='languages'
readonly POT="${LANG_DIR}/${DOMAIN}.pot"
readonly I18N_MAP='build/i18n-map.json'
readonly EXCLUDE='build,node_modules,vendor,languages,tests,stubs,.claude'
readonly POT_HEADERS='{"Report-Msgid-Bugs-To":"https://github.com/humanmade/uat-checklist/issues","Language-Team":"Human Made <support@humanmade.com>"}'

die() {
	printf 'error: %s\n' "$1" >&2
	exit 1
}

command -v wp > /dev/null || die 'WP-CLI is not installed: https://wp-cli.org/#installing'

make_pot() {
	wp i18n make-pot . "$1" \
		--slug="${DOMAIN}" \
		--domain="${DOMAIN}" \
		--package-name="${PACKAGE_NAME}" \
		--headers="${POT_HEADERS}" \
		--exclude="${EXCLUDE}"
}

# A plugin's catalog is loaded as <domain>-<locale>.po; this returns the locale.
locale_of() {
	local name
	name="$(basename "$1" .po)"
	echo "${name#"${DOMAIN}-"}"
}

# The gettext plural rule for a locale's language, or nothing when it is not listed: a wrong rule silently picks
# the wrong translation, where a missing one is visible to whoever opens the catalog.
plural_forms_for() {
	case "${1%%_*}" in
		ja | zh | ko | vi | th | id | ms) echo 'nplurals=1; plural=0;' ;;
		en | de | nl | sv | da | nb | it | es | pt | fi | el | he) echo 'nplurals=2; plural=(n != 1);' ;;
		fr) echo 'nplurals=2; plural=(n > 1);' ;;
		*) echo '' ;;
	esac
}

scaffold_locale() {
	local locale="$1"
	local po="${LANG_DIR}/${DOMAIN}-${locale}.po"

	[[ -f "${POT}" ]] || make_pot "${POT}"

	if [[ -f "${po}" ]]; then
		wp i18n update-po "${POT}" "${po}"
		sync_header "${po}"
		return
	fi

	cp "${POT}" "${po}"

	# WP-CLI's POT carries neither header. Without Plural-Forms, gettext falls back to the English two-form rule.
	awk -v loc="${locale}" -v plurals="$(plural_forms_for "${locale}")" '
		{ print }
		/^"MIME-Version: 1.0/ && !done {
			print "\"Language: " loc "\\n\""
			if ( plurals != "" ) { print "\"Plural-Forms: " plurals "\\n\"" }
			done = 1
		}
	' "${po}" > "${po}.tmp" && mv "${po}.tmp" "${po}"

	sync_header "${po}"
	echo "Created ${po}"
}

# update-po keeps a catalog's header as it was when the catalog was created, so the version is copied from the
# POT. The POT leaves Last-Translator and PO-Revision-Date as placeholders, which msgfmt -c warns about: those are
# filled while they are still placeholders, with the catalog's own Language-Team rather than a person, and a value
# a translator has set is kept. Only the header is read, above the first blank line.
sync_header() {
	local po="$1"

	# Through the environment, not -v: awk turns the \n that ends each header line into a real newline in a -v value.
	VERSION_LINE="$(grep -m1 '^"Project-Id-Version: ' "${POT}")" \
	TEAM="$(grep -m1 '^"Language-Team: ' "${po}" | sed -e 's/^"Language-Team: //' -e 's/\\n"$//')" \
	NOW="$(date -u '+%Y-%m-%d %H:%M+0000')" \
	awk '
		/^$/ { body = 1 }
		!body && /^"Project-Id-Version: / { print ENVIRON["VERSION_LINE"]; next }
		!body && /^"Last-Translator: FULL NAME / && ENVIRON["TEAM"] != "" { print "\"Last-Translator: " ENVIRON["TEAM"] "\\n\""; next }
		!body && /^"PO-Revision-Date: YEAR-MO-DA / { print "\"PO-Revision-Date: " ENVIRON["NOW"] "\\n\""; next }
		{ print }
	' "${po}" > "${po}.tmp" && mv "${po}.tmp" "${po}"
}

compile_locale() {
	local locale="$1"
	local po="${LANG_DIR}/${DOMAIN}-${locale}.po"

	[[ -f "${po}" ]] || die "No catalog for ${locale} (expected ${po}). Run: bin/i18n locale ${locale}"
	[[ -f "${I18N_MAP}" ]] || die "No ${I18N_MAP}, so the editor's JSON catalogs cannot be named. Run: npm run build"

	wp i18n make-mo "${po}" "${LANG_DIR}"
	wp i18n make-php "${po}" "${LANG_DIR}"

	# A renamed bundle changes its hash, so catalogs from an earlier build are removed rather than left behind.
	rm -f "${LANG_DIR}/${DOMAIN}-${locale}-"*.json

	# --no-purge, or make-json deletes every JavaScript string from the committed PO.
	wp i18n make-json "${po}" "${LANG_DIR}" --domain="${DOMAIN}" --use-map="${I18N_MAP}" --no-purge
}

each_locale() {
	shopt -s nullglob
	local po
	for po in "${LANG_DIR}/${DOMAIN}-"*.po; do
		"$1" "$(locale_of "${po}")"
	done
}

check() {
	[[ -f "${POT}" ]] || die "No POT at ${POT}. Run: bin/i18n pot"
	command -v msgfmt > /dev/null || die 'msgfmt is not installed (gettext), so the catalogs cannot be validated.'

	local tmp
	tmp="$(mktemp -d)"
	trap 'rm -rf "${tmp}"' RETURN

	make_pot "${tmp}/check.pot" > /dev/null

	# POT-Creation-Date changes on every run and means nothing.
	if ! diff <(grep -v '^"POT-Creation-Date' "${POT}") <(grep -v '^"POT-Creation-Date' "${tmp}/check.pot") > "${tmp}/diff"; then
		head -40 "${tmp}/diff" >&2
		die "${POT} is out of date. Run: bin/i18n pot"
	fi
	echo "${POT} matches the code"

	shopt -s nullglob
	local po
	for po in "${LANG_DIR}/"*.po; do
		msgfmt -c -o /dev/null "${po}" || die "${po} does not compile"
		echo "${po} compiles"
	done
}

case "${1:-all}" in
	all)
		make_pot "${POT}"
		each_locale scaffold_locale
		each_locale compile_locale
		;;
	pot) make_pot "${POT}" ;;
	locale)
		[[ -n "${2:-}" ]] || die 'Usage: bin/i18n locale <locale>'
		scaffold_locale "$2"
		;;
	compile)
		if [[ -n "${2:-}" ]]; then
			compile_locale "$2"
		else
			each_locale compile_locale
		fi
		;;
	check) check ;;
	*) die "Unknown command: $1" ;;
esac
