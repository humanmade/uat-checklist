# Excluded from the distributed plugin. One gitignore-style pattern per line, the format
# wp-cli/dist-archive-command reads. Mirrors .gitattributes; change the two together.
#
# build/ is deliberately NOT listed, even though .gitignore holds it. It is the plugin: inc/blocks.php registers
# every block from build/blocks/, and inc/panel.php and inc/guide.php enqueue build/panel.js, build/panel.css and
# build/guide.css. Each returns early when its file is absent, so an archive without build/ installs cleanly and
# does nothing at all. The release branch gets it force-added by the build workflow.
#
# languages/ ships: it holds the translation catalogs, compiled.
#
# composer.json is deliberately NOT listed either. It carries `type: wordpress-plugin`, which is what lets this be
# installed as a composer dependency.
#
# AGENTS.md, CLAUDE.md (a symlink to it) and .claude/ ship as well, so the agent instructions and the
# creating-a-uat-page skill come with the installed plugin.

# Version control and CI
.git
.gitignore
.gitattributes
.distignore
.editorconfig
.nvmrc
.github

# Dev tooling config
.phpcs.xml
phpstan.neon.dist
.wp-env.json
eslint.config.js
prettier.config.js
.prettierignore
.stylelintrc.json
webpack.config.js
package.json
package-lock.json
composer.lock
bin

# Dev dependencies.
node_modules
vendor

# Internal notes and design records, not user documentation
docs
PRODUCT.md
.impeccable

# Compiled to build/, which is what ships.
src
blocks

# PHPStan only, never loaded at runtime.
stubs

# Tests
tests

.DS_Store
