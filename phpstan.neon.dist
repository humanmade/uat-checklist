includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	# Level 5 checks argument types, return types, property types and dead code
	# without demanding native type hints on every symbol.
	level: 5

	phpVersion: 80400

	paths:
		- inc
		- blocks
		- uat-checklist.php

	excludePaths:
		analyse:
			# Generated by `npm run build`; *.asset.php are array literals with
			# no useful types.
			- 'build/*'
			- 'node_modules/*'
			- 'vendor/*'

	# WordPress core comes from php-stubs/wordpress-stubs through the include
	# above. WP-CLI is supplied by the host at runtime, so it is stubbed here.
	scanFiles:
		- stubs/wp-cli.php

	treatPhpDocTypesAsCertain: false
