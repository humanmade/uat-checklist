{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"steps": [
		{
			"step": "activatePlugin",
			"pluginPath": "uat-checklist/uat-checklist.php"
		},
		{
			"step": "setSiteOptions",
			"options": {
				"permalink_structure": "/%postname%/"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; foreach ( [ [ 'uat-manager', 'manager@humanmade.com', 'editor' ], [ 'uat-tester', 'tester@client.example', 'subscriber' ] ] as [ $login, $email, $role ] ) { wp_insert_user( [ 'user_login' => $login, 'user_pass' => 'password', 'user_email' => $email, 'role' => $role, 'display_name' => $login ] ); }"
		}
	]
}
