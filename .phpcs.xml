<?xml version="1.0"?>
<ruleset name="UAT Checklist Coding Standards">
	<description>Human Made Coding Standards</description>

	<!-- What to scan -->
	<file>./inc/</file>
	<file>./blocks/</file>
	<file>uat-checklist.php</file>

	<exclude-pattern>./build/</exclude-pattern>
	<exclude-pattern>./node_modules/</exclude-pattern>
	<exclude-pattern>./vendor/</exclude-pattern>
	<exclude-pattern>*.js</exclude-pattern>

	<!-- How to scan -->
	<arg value="sp"/> <!-- Show sniff and progress -->
	<arg name="colors"/> <!-- Show results with colors (disable if working on Windows). -->
	<arg name="basepath" value="."/> <!-- Show paths as the relevant relative path. -->
	<arg name="parallel" value="8"/> <!-- Enables parallel processing when available. -->
	<arg name="extensions" value="php"/>

	<config name="minimum_supported_wp_version" value="7.1"/>

	<!-- The HM standard sets 8.2-; the plugin header requires 8.4. -->
	<config name="testVersion" value="8.4-"/>

	<rule ref="HM">
		<!--
		Every file pairs symbol declarations with the standard WordPress
		`defined( 'ABSPATH' ) || exit;` guard, which PSR-1 counts as a side
		effect. The guard is required, so this rule can never be satisfied here.
		-->
		<exclude name="PSR1.Files.SideEffects"/>
	</rule>

	<!--
	WordPress locates the header in the main file by name, and finds a block's
	render.php beside its block.json, so neither can move into inc/.
	-->
	<!--
	A render.php receives $attributes, $content and $block from core, and an inline `/** @var */` is how PHPStan
	learns their types. It is a type annotation with no summary to give, not a docblock.
	-->
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>./blocks/</exclude-pattern>
	</rule>

	<rule ref="HM.Files.NamespaceDirectoryName.NoIncDirectory">
		<exclude-pattern>uat-checklist.php</exclude-pattern>
		<exclude-pattern>./blocks/</exclude-pattern>
	</rule>
</ruleset>
